---
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import { ctaLabel, header } from '../data/copy';
import { site } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-page items-center gap-6 px-4 md:px-6">
    <Logo />

    <div class="ml-auto flex items-center gap-6">
      <nav aria-label={header.nav} class="hidden lg:block">
        <ul class="flex gap-6">
          {site.nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-muted transition-colors hover:text-fg">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={site.phoneHref} class="hidden text-sm font-medium md:block">
        {site.phone}
      </a>
      <div class="hidden sm:block">
        <Button href="#booking" size="sm">
          {ctaLabel}
        </Button>
      </div>
      <button
        type="button"
        popovertarget="mobile-menu"
        aria-label={header.openMenu}
        class="grid size-12 place-items-center lg:hidden"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 stroke-fg" stroke-width="1.5">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    popover
    class="inset-0 m-0 h-dvh max-h-none w-full max-w-none border-0 bg-bg p-0 text-fg"
  >
    <div class="flex h-16 items-center justify-between border-b border-line px-4 md:px-6">
      <Logo />
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        aria-label={header.closeMenu}
        class="grid size-12 place-items-center"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 stroke-fg" stroke-width="1.5">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <nav aria-label={header.nav} class="px-4 py-8 md:px-6">
      <ul class="flex flex-col gap-2">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="block py-2 font-display text-3xl uppercase">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-col gap-4">
        <a href={site.phoneHref} class="text-lg font-medium">
          {site.phone}
        </a>
        <Button href="#booking">{ctaLabel}</Button>
      </div>
    </nav>
  </div>
</header>

<script>
  // Popover сам не закрывается при переходе по якорю внутри него
  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.hidePopover();
  });
</script>
