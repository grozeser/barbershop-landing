---
import Button from './ui/Button.astro';
import { ctaLabel } from '../data/copy';
---

<!-- Скрыта, пока на экране hero или форма: там уже есть своя кнопка -->
<div
  id="mobile-cta"
  data-hidden
  class="fixed inset-x-0 bottom-0 z-30 border-t border-line bg-bg/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur transition-[translate,visibility] duration-300 data-[hidden]:invisible data-[hidden]:translate-y-full motion-reduce:transition-none md:hidden"
>
  <Button href="#booking" class="w-full">
    {ctaLabel}
  </Button>
</div>

<script>
  const cta = document.getElementById('mobile-cta')!;
  const visible = new Set<Element>();
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) visible.add(entry.target);
      else visible.delete(entry.target);
    }
    cta.toggleAttribute('data-hidden', visible.size > 0);
  });
  ['hero', 'booking'].forEach((id) => observer.observe(document.getElementById(id)!));
</script>
