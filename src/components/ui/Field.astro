---
// Подпись, поле (slot) и место для ошибки. У поля в slot нужен
// aria-describedby="{for}-error" — скрипт формы пишет туда текст ошибки
interface Props {
  label: string;
  for: string;
  note?: string;
  class?: string;
}

const { label, for: id, note, class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-2', className]}>
  <label for={id} class="text-sm font-medium">
    {label}
    {note && <span class="font-normal text-muted"> · {note}</span>}
  </label>
  <slot />
  <p id={`${id}-error`} class="text-sm text-error empty:hidden"></p>
</div>
