---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

// Пропорции задаются через class, кадр обрезается по ним (object-cover)
interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
  priority?: boolean;
}

const { src, alt, sizes, class: className, priority = false } = Astro.props;
---

<Picture
  src={src}
  alt={alt}
  sizes={sizes}
  widths={[400, 800, 1200, 1600].filter((w) => w <= src.width)}
  formats={['avif', 'webp']}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  class="h-full w-full object-cover"
  pictureAttributes={{ class: ['block overflow-hidden bg-surface-2', className].join(' ') }}
/>
