---
import Base from '../layouts/Base.astro';
---

<Base
  title="«Опасная бритва» — барбершоп"
  description="Мужские стрижки, бритьё опасной бритвой и уход за бородой. Концепт лендинга для портфолио."
>
  <main class="mx-auto flex min-h-dvh max-w-[1200px] flex-col items-start justify-center gap-6 px-4 md:px-6">
    <p class="font-display text-sm tracking-[0.3em] text-accent uppercase">Барбершоп</p>
    <h1 class="font-display text-[clamp(3rem,10vw,5rem)] leading-none font-semibold uppercase">
      Опасная бритва
    </h1>
    <div class="h-px w-24 bg-accent" aria-hidden="true"></div>
    <p class="max-w-prose text-lg text-muted">
      Сайт в разработке. Скоро здесь появятся услуги, мастера и онлайн-запись.
    </p>
    <p class="text-sm text-muted">Концепт для портфолио, бизнес вымышленный.</p>
  </main>
</Base>
