---
import Base from '../layouts/Base.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import { footer, hero } from '../data/copy';
import { site } from '../data/site';
---

<Base
  title={`${site.name} — барбершоп в Москве`}
  description="Мужские стрижки, борода и королевское бритьё опасной бритвой. Концепт лендинга для портфолио."
>
  <main class="mx-auto flex min-h-dvh max-w-page flex-col justify-center gap-10 px-4 py-16 md:px-6">
    <div class="flex flex-wrap items-center gap-4">
      <p class="font-display text-xl font-semibold tracking-[0.2em] uppercase">{site.name}</p>
      <Badge>Сайт в разработке</Badge>
    </div>

    <div class="max-w-3xl">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="mt-4 font-display text-[clamp(3rem,10vw,5rem)] leading-[1.1] font-semibold uppercase">
        {hero.title}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{hero.lead}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="#booking">{hero.primaryCta}</Button>
        <Button href="#services" variant="ghost">
          {hero.secondaryCta}
        </Button>
      </div>
    </div>

    <dl class="grid max-w-3xl grid-cols-3 gap-4 border-t border-line pt-8 md:gap-6">
      {site.stats.map((stat) => (
        <div class="flex flex-col-reverse justify-end gap-1">
          <dt class="text-sm text-muted">{stat.label}</dt>
          <dd class="font-display text-2xl font-semibold text-accent md:text-4xl">{stat.value}</dd>
        </div>
      ))}
    </dl>

    <p class="text-sm text-muted">{footer.disclaimer}</p>
  </main>
</Base>
