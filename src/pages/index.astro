---
import Base from '../layouts/Base.astro';
import Booking from '../components/Booking.astro';
import Contacts from '../components/Contacts.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Masters from '../components/Masters.astro';
import MobileCta from '../components/MobileCta.astro';
import Reviews from '../components/Reviews.astro';
import Services from '../components/Services.astro';
import { header } from '../data/copy';
import { site } from '../data/site';
---

<Base
  title={`${site.name} — барбершоп в Москве`}
  description="Мужские стрижки, борода и королевское бритьё опасной бритвой. Концепт лендинга для портфолио."
>
  <a
    href="#main"
    class="sr-only z-50 bg-accent px-4 py-3 text-bg focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
  >
    {header.skipLink}
  </a>
  <Header />
  <main id="main">
    <Hero />
    <Features />
    <Services />
    <Masters />
    <Gallery />
    <Reviews />
    <Booking />
    <Faq />
    <Contacts />
  </main>
  <Footer />
  <MobileCta />
</Base>
